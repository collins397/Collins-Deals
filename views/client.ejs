<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clients - Car Deals Management System</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header>
        <h1>Car Deals Management System</h1>
        <p>Client Management</p>
    </header>

    <nav>
        <a href="/">Dashboard</a>
        <a href="/clients">Clients</a>
        <a href="/car_types">Car Types</a>
        <a href="/suppliers">Suppliers</a>
        <a href="/employees">Employees</a>
        <a href="/sales">Sales</a>
        <% if (user) { %><a class="logout-button" href="/logout">Log out</a><% } %>
    </nav>

    <main>

        <h2>Client Management</h2>

        <div class="form-container">

            <h3>Add New Client</h3>

            <form action="/clients" method="POST">

                <div class="form-group">
                    <label for="client_id">Client ID</label>
                    <input type="number" id="client_id" name="client_id" required>
                </div>

                <div class="form-group">
                    <label for="contact">Contact</label>
                    <input type="text" id="contact" name="contact" required>
                </div>

                <div class="form-group">
                    <label for="location">Location</label>
                    <input type="text" id="location" name="location" required>
                </div>

                <button type="submit">Add Client</button>

            </form>

        </div>

        <div class="data-container">
            <h3>Clients List</h3>
            <% if (clients && clients.length > 0) { %>
                <table border="1">
                    <thead>
                        <tr>
                            <th>Client ID</th>
                            <th>Contact</th>
                            <th>Location</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% clients.forEach(client => { %>
                            <tr>
                                <td><%= client.client_id %></td>
                                <td><%= client.contact %></td>
                                <td><%= client.location %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <p>No clients found</p>
            <% } %>
        </div>

    </main>

    <footer>
        <p>Car Deals Management System</p>
    </footer>

</body>
</html>