<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Suppliers - Car Deals Management System</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header>
        <h1>Car Deals Management System</h1>
        <p>Supplier Management</p>
    </header>

    <nav>
        <a href="/">Dashboard</a>
        <a href="/clients">Clients</a>
        <a href="/car_types">Car Types</a>
        <a href="/suppliers">Suppliers</a>
        <a href="/employees">Employees</a>
        <a href="/sales">Sales</a>
        <% if (user) { %><a class="logout-button" href="/logout">Log out</a><% } %>
    </nav>

    <main>

        <h2>Add Supplier</h2>

        <div class="form-container">

            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                <p role="alert"><%= errorMessage %></p>
            <% } %>

            <form action="/suppliers" method="POST">

                <div class="form-group">
                    <label for="supplier_id">Supplier ID</label>
                    <input type="number" id="supplier_id" name="supplier_id" required>
                </div>

                <div class="form-group">
                    <label for="name">Name</label>
                    <input type="text" id="name" name="name" required>
                </div>

                <div class="form-group">
                    <label for="phone">Phone</label>
                    <input type="text" id="phone" name="phone" required>
                </div>

                <button type="submit">Add Supplier</button>

            </form>

        </div>

        <div class="data-container">
            <h3>Suppliers List</h3>
            <% if (suppliers && suppliers.length > 0) { %>
                <table border="1">
                    <thead>
                        <tr>
                            <th>Supplier ID</th>
                            <th>Name</th>
                            <th>Phone</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% suppliers.forEach(supplier => { %>
                            <tr>
                                <td><%= supplier.supplier_id %></td>
                                <td><%= supplier.name %></td>
                                <td><%= supplier.phone %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <p>No suppliers found</p>
            <% } %>
        </div>

    </main>

    <footer>
        <p>Car Deals Management System</p>
    </footer>

</body>
</html>