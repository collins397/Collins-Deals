<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cars - Car Deals Management System</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header>
        <h1>Car Deals Management System</h1>
        <p>Car Management</p>
    </header>

    <nav>
        <a href="/">Dashboard</a>
        <a href="/clients">Clients</a>
        <a href="/car_types">Car Types</a>
        <a href="/suppliers">Suppliers</a>
        <a href="/employees">Employees</a>
        <a href="/sales">Sales</a>
        <% if (user) { %><a class="logout-button" href="/logout">Log out</a><% } %>
    </nav>

    <main>

        <h2>Car Management</h2>

        <div class="form-container">

            <h3>Add New Car Type</h3>

            <form action="/car-types" method="POST">

                <div class="form-group">
                    <label for="car_name">Car Name</label>
                    <input type="text" id="car_name" name="car_name" required>
                </div>

                <div class="form-group">
                    <label for="price">Price</label>
                    <input type="number" id="price" name="price" required>
                </div>

                <div class="form-group">
                    <label for="warranty">Warranty</label>
                    <input type="text" id="warranty" name="warranty" required>
                </div>

                <div class="form-group">
                    <label for="supplier_id">Supplier ID</label>
                    <input type="number" id="supplier_id" name="supplier_id" required>
                </div>

                <button type="submit">Add Car Type</button>

            </form>

        </div>

        <div class="data-container">
            <h3>Car Types List</h3>
            
            <% if (car_types && car_types.length > 0) { %>
                <table border="1">
                    <thead>
                        <tr>
                            <th>Car Name</th>
                            <th>Price</th>
                            <th>Warranty</th>
                            <th>Supplier ID</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% car_types.forEach(car_type => { %>
                            <tr>
                                <td><%= car_type.car_name %></td>
                                <td><%= car_type.price %></td>
                                <td><%= car_type.warranty %></td>
                                <td><%= car_type.supplier_id %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <p>No car types found</p>
            <% } %>
        </div>

    </main>

    <footer>
        <p>Car Deals Management System</p>
    </footer>

</body>
</html>
